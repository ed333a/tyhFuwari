---
import LayoutWithoutSideBar from "@layouts/LayoutWithoutSideBar.astro"
import { friendLinks } from "@/types/cfg-frlink"
import { getImageUrl } from "@/utils/get-bg-url"
import { Icon } from "astro-icon/components"
---

<LayoutWithoutSideBar>
    <div    id="exchange-guide" 
            class="
                mt-[30px]
                bg-white/80 dark:bg-[rgba(18,18,18,0.8)] rounded-[1.25rem] py-[0.85rem] px-[1.5rem]
                mb-[2rem] flex item-center wrap justify-between gap-[1rem] 
                shadow-[0_2px_8px_rgba(0,0,0,0.03),0_1px_2px_rgba(0,0,0,0.05)]
                transition-all duration-200 ease-in
                dark:hover:translate-y-[-2px] hover:translate-y-[-2px]
            "
    >
        <div id="guide-text" class="flex items-center gap-[0.65rem] wrap text-[0.95rem] text-slate-900 dark:text-slate-100">
            <span class="text-[1.5rem] drop-shadow-[0_1px_2px_rgba(0,0,0,0.1)]">🤝✨</span>
            <span>与更多优质站点互链，扩大影响力</span>
        </div>
        <a href="/exchange" rel="noopener noreferrer"
            class="
                bg-neutral-100 text-slate-600 dark:bg-slate-700 dark:text-neutral-100 no-underline px-[1.3rem] py-[0.5rem]
                rounded-full font-[600] text-[0.9rem] inline-flex items-center
                gap-[0.5rem] shadow-[0_2px_6px_rgba(0,0,0,0.2)] dark:shadow-[0_2px_6px_rgba(255,255,255,0.1)]
                border border-solid border-[rgba(255,255,255,0.65)] dark:border-[rgba(3,35,120,0.65)]
            "
        >
            📝 前往友链交换页面
            <span>→</span>
        </a>
    </div> <!-- exchange-guide -->

    <div id="fr-lists" class="card-base mt-[20px] relative-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 transition-all duration-300">
        <!-- 头部内容区域 -->
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-extrabold bg-gradient-to-r 
            from-slate-800 via-indigo-800 to-purple-800
            dark: from-cyan-100 via-indigo-400 to-rose-4 00
            bg-clip-text text-transparent tracking-tight 
            drop-shadow-sm
        ">
                🔗 友情链接
            </h1>
            <div class="inline-flex items-center gap-2 mt-5 px-5 py-1.5 
                bg-white/40 dark:bg-indigo-800 backdrop-blur-md rounded-full 
                text-indigo-800 dark:text-neutral-100
                text-sm font-medium border border-white/50 shadow-sm"
            >
                <span>✨</span> 一群非常优秀的小伙伴们
            </div>
            <p class="text-slate-700 dark:text-slate-100 max-w-2xl mx-auto 
                mt-4 text-base font-medium drop-shadow-sm"
            >
                很高兴与优秀的你们相遇于此，愿我们彼此照亮，在各自的道路上走得更远。
            </p>
        </div>

        <!-- 分组 -->
        <div id="fr-groups-wrapper">
            {
                friendLinks.map((group) => (
                    <div id="fr-group-wrapper">
                        {/* 分组顶部的介绍 */}
                        <div class="border-l-4 border-[var(--primary)] pl-5 mb-6">
                            <div class="flex items-center gap-3 flex-wrap">
                                <h2 class="text-2xl md:text-3xl font-bold text-slate-800 
                                    dark:text-slate-100 flex items-center gap-2 drop-shadow-sm"
                                >{group.name}</h2>

                                {
                                    group.tag && 
                                    <span class="group-tag">
                                        {group["link-list"].length}{group.tag}
                                    </span>
                                }
                            </div>

                            <p class="group-desc">{group.desc}</p>
                        </div>

                        {/* 分组下的站点列表 */}
                        <div class="flex flex-wrap gap-[1.5rem] mb-[3rem]">
                            {
                                group["link-list"].length === 0 && 
                                <div class="w-full flex justify-center">
                                    <div class="w-fit card-base p-[20px] font-[900]">
                                        <h1 class="text-[20px] text-indigo-500"> 好邻居正在招募中…… </h1>
                                    </div>
                                </div>
                            }

                            {
                                group["link-list"].map((link) => (
                                    <div id="fr-card" class="fr-card">
                                        <div id="site-cover" class="site-cover" style={`background-image: url(${getImageUrl(link.cover)});`}></div>
                                        <div id="card-content" class="card-content">
                                            <div>
                                                <div id="header-content" class="header-content">
                                                    {
                                                        link.icon &&
                                                        <div id="site-icon" class="site-icon" style={`background-image: url(${getImageUrl(link.icon)});`}></div>
                                                    }
                                                    <div id="site-title-wrapper" class="w-full">
                                                        <div id="site-title" class="site-title" title={link.name}>{link.name}</div>
                                                        <a class="site-domain" href={`https://${link.link}`} target="_blank" rel="noopener noreferrer">
                                                            {link.link}
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="site-description" title={link.descr}>{link.descr}</div>
                                            </div>
                                            <div id="card-footer" class="site-footer">
                                                <div id="site-time" class="site-time"><Icon name="fa6-solid:calendar"/>{link.date}</div>
                                                <a id="visit-link" class="visit-link" target="_blank" href={`https://${link.link}`} rel="noopener noreferrer">
                                                    <span>访问</span>
                                                    <span class="visit-animation inline-block">→</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                ))
            }
        </div>
    </div> <!-- fr-lists -->
</LayoutWithoutSideBar>

<style>
    .visit-link {
        @apply text-[0.74rem] border border-solid rounded-full mt-[0.5rem] px-[15px];
    }

    .visit-animation {
        transition: transform 0.2s ease;
    }

    .visit-link:hover .visit-animation {
        transform: translateX(2px);
    }

    .site-footer {
        @apply flex flex-row items-center justify-between border-t border-solid text-slate-100;
    }

    .site-time {
        @apply text-[0.74rem] flex items-center gap-[0.3rem] pt-[0.5rem] tracking-[0.3px];
    }

    .site-description {
        @apply text-[0.72rem] leading-[1.35] mx-[0.5rem] mb-[0.5rem] line-clamp-2 break-words
        rounded-[8px] text-slate-100;
    }

    .site-domain {
        font-family: 'SF Mono', 'Fira Code', monospace;
        @apply mt-[5px] font-[100] text-[12px] inline-block px-[0.6rem]
        rounded-full mx-[0.2rem] w-full text-amber-500 
        hover:text-amber-300 border border-solid border-[rgba(255,255,200,0.2)]
        transition-colors duration-200 no-underline line-clamp-1;
        backdrop-filter: brightness(0.8);
    }

    .site-title {
        @apply w-full pl-2 text-[1.05rem] font-[700] tracking-[-0.2px] leading-[1.3] 
        break-words overflow-hidden text-neutral-100 line-clamp-1;
    }

    .site-icon {
        @apply bg-cover p-[1.6rem] rounded-full border-[2px] border-slate-200;
    }

    .header-content {
        @apply flex items-center gap-[0.7rem] mb-[0.6rem] flex-nowrap 
        rounded-[15px] px-[10px];
    }

    .fr-card {
        flex: 0 0 calc((100% - (3 * 1.5rem)) / 4); /* 4 个卡片, 3 个间隙 */
        @apply bg-white rounded-[1.25rem] overflow-hidden relative
        transition-all duration-[250ms] ease-in cursor-pointer
        hover:translate-y-[-4px] dark:hover:translate-y-[-4px];
    }

    .fr-card:hover .site-cover {
        transform: scale(1.03);
    }

    .site-cover {
        @apply absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat
        transition-transform duration-[400ms] ease-in;
    }

    .card-content {
        @apply relative z-[2] px-[1.2rem] py-[1rem] h-full flex 
        flex-col justify-between rounded-[1.25rem] backdrop-blur-[2px];
        background: linear-gradient(180deg, #00000000, 45%, #000000bd);
        transition: background 0.2s;
    }

    .group-desc {
        @apply text-slate-700 dark:text-slate-100 
        text-sm md:text-base mt-2 max-w-3xl 
        bg-white/30 dark:bg-white/10 backdrop-blur-sm 
        rounded-xl px-4 py-2 border border-white/20;
    }
    
    .group-tag {
        @apply text-xs font-semibold bg-purple-200 backdrop-blur-sm 
        text-indigo-500 rounded-full px-3 py-1 border border-white/40
        shadow-[5px_5px_20px_rgba(0,0,0,0.15)]
        dark:shadow-[5px_5px_20px_rgba(255,255,255,0.15)];
    }

    /* 响应式 */
    @media (max-width: 1060px) {
        .fr-card {
            flex: 0 0 calc((100% - (2 * 1.5rem)) / 3);
        }
    }

    @media (max-width: 800px) {
        .fr-card {
            flex: 0 0 calc((100% - (1 * 1.5rem)) / 2);
        }
    }

    @media (max-width: 560px) {
        .fr-card {
            flex: 0 0 100%;
        }
    }
</style>
